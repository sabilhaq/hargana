{
  "name": "hargana",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "node scripts/copy-zxing-wasm.mjs",
    "lint": "eslint && node scripts/check-logical-css.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "user:create": "tsx --env-file-if-exists=.env scripts/create-user.ts",
    "user:password": "tsx --env-file-if-exists=.env scripts/set-password.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "better-auth": "^1.7.11",
    "dexie": "^4.4.6",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "fuse.js": "^7.5.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "^6.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.4.2"
}
