# Random string, at least 32 characters (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# Public URL of the app. Required in production; leave empty locally so it is
# inferred from the request (works on any dev port).
BETTER_AUTH_URL=
# Neon Postgres connection string. Leave empty locally to use the embedded
# PGlite database in .data/pglite.
DATABASE_URL=

# Local-only owner account used by `pnpm user:create` when no arguments are
# given. Never use these values for a deployed database.
DEV_OWNER_EMAIL=owner@hargana.test
DEV_OWNER_PASSWORD=hargana-dev-123
# Local-only contributor account, for trying what friends can and can't do:
#   pnpm user:create $DEV_CONTRIBUTOR_EMAIL $DEV_CONTRIBUTOR_PASSWORD Budi
DEV_CONTRIBUTOR_EMAIL=budi@hargana.test
DEV_CONTRIBUTOR_PASSWORD=hargana-dev-456
